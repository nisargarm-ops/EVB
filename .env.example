# ==============================================================================
# BatteryPass 360 - Environment Configuration Template (.env.example)
# ==============================================================================

# Core Application Settings
PROJECT_NAME=BatteryPass 360
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=your-secure-jwt-secret-key-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (JSON Array or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Supabase PostgreSQL & Auth Credentials
# Set USE_MEMORY_DB=false when deploying to production with real Supabase instance
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-privileged-key
USE_MEMORY_DB=true

# QpiAI Integration (Teammate 4 Modules)
QPIAI_OPT_API_KEY=
QPIAI_OPT_URL=https://opt.qpiai.tech/api/v1
QPIAI_QUANTUM_API_KEY=
QPIAI_QUANTUM_BACKEND=QpiAI-QSV-Local

# Frontend Client Env Vars (Vite prefix)
VITE_QPIAI_OPT_API_KEY=
VITE_QPIAI_QUANTUM_API_KEY=