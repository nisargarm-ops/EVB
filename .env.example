# ==============================================================================
# BatteryPass 360 - Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit production secrets, secret keys, or private keys to git.
# - Copy this file to .env for local development: `cp .env.example .env`
# - In production, inject these variables via secure secret managers or platform secrets.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="BatteryPass 360"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# JWT Security & Dev Controls
# REQUIRED in production: Generate a high-entropy 256-bit secret key (e.g., `openssl rand -base64 32`)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_DEV_ROLE_SWITCHING=true

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Supabase PostgreSQL & Auth Credentials (Server-Side)
USE_MEMORY_DB=false
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_public_key"
SUPABASE_KEY="sb_publishable_your_public_key"
SUPABASE_SECRET_KEY="sb_secret_your_server_only_secret_key"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_server_only_secret_key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# QpiAI Integration (Server-Side Only — NEVER expose via VITE_)
QPIAI_OPT_API_KEY=""
QPIAI_OPT_URL="https://opt.qpiai.tech/api/v1"
QPIAI_QUANTUM_API_KEY=""
QPIAI_QUANTUM_BACKEND="QpiAI-QSV-Local"

# Frontend Client Environment Variables (Publishable / Protected by RLS only)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_public_key"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_public_key"