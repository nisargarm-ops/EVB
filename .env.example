# ==============================================================================
# BatteryPass 360 - Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit production secrets, service role keys, or private keys to git.
# - Copy this file to .env for local development: `cp .env.example .env`
# - In production, inject these variables via secure secret managers (e.g., Vault,
#   Google Cloud Secret Manager, or platform environment variables).
# ==============================================================================

# Core Application Settings
PROJECT_NAME="BatteryPass 360"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# JWT Security
# REQUIRED in production: Generate a high-entropy 256-bit secret key (e.g., `openssl rand -base64 32`)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Supabase PostgreSQL & Auth Credentials
# Set USE_MEMORY_DB=false when connecting to a real Supabase instance
USE_MEMORY_DB=true
SUPABASE_URL="https://your-project-ref.supabase.co"
# Anon key: safe for browser / public client operations (protected by Row Level Security)
SUPABASE_KEY="your-supabase-public-anon-key"
# Service Role key: confidential backend-only key that bypasses RLS (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-service-role-key"

# QpiAI Integration (Teammate 4 Modules)
QPIAI_OPT_API_KEY=""
QPIAI_OPT_URL="https://opt.qpiai.tech/api/v1"
QPIAI_QUANTUM_API_KEY=""
QPIAI_QUANTUM_BACKEND="QpiAI-QSV-Local"

# Frontend Client Environment Variables (Vite client-side exposure)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"
VITE_QPIAI_OPT_API_KEY=""
VITE_QPIAI_QUANTUM_API_KEY=""