# ==============================================================================
# BatteryPass 360 - Environment Configuration
# ==============================================================================

# Core Service Configuration
PROJECT_NAME="BatteryPass 360"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
DEBUG=true

# Security & Authentication
SECRET_KEY="batterypass360-insecure-development-secret-key-replace-me-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Database Configuration (Supabase PostgreSQL)
USE_MEMORY_DB=true
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# QpiAI-Opt Cloud Solver Configuration
QPIAI_OPT_URL="https://opt.qpiai.tech/api/v1"
QPIAI_OPT_API_KEY=""

# QpiAI Quantum SDK / QpiAI QCloud Configuration
QPIAI_QUANTUM_API_KEY=""
QPIAI_QUANTUM_BACKEND="QpiAI-QSV-Local"
