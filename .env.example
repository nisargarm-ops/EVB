# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=
VITE_SUPABASE_URL=

# Public Anon / Publishable Key (safe for browser client)
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secret / Service Role Key (STRICTLY SERVER-SIDE - never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_KEY=

# Supabase Auth JWKS URL (optional, defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=

# ==============================================================================
# QpiAI Integrations (Server-Side Only)
# ==============================================================================
# QpiAI-Opt QUBO Reverse Logistics Platform API Key (from https://opt.qpiai.tech)
QPIAI_OPT_API_KEY=
QPIAI_OPT_URL=

# QpiAI Quantum / QCloud Cathode Degradation Modeling API Key (from https://qcloud.qpiai.tech)
QPIAI_QUANTUM_API_KEY=
QPIAI_QUANTUM_BACKEND=

# ==============================================================================
# Application & Security Settings
# ==============================================================================
PROJECT_NAME=BatteryPass 360
ENVIRONMENT=development
ENABLE_DEV_ROLE_SWITCHING=true
SECRET_KEY=
FORCE_MEMORY_DB=false
USE_MEMORY_DB=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*
ALGORITHM=HS256
API_V1_STR=/api/v1
DEBUG=false